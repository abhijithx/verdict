# Verdict AI — Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to .env and configure your API credentials and settings.
# -----------------------------------------------------------------------------

# Primary AI Provider: 'gemini' or 'groq' (auto-fallback enabled if primary fails)
AI_PROVIDER=gemini

# Google Gemini API Configuration
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Groq API Configuration (Fast inference fallback)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Local Code Execution Sandbox Engine ('local' = native sandboxed execution)
EXECUTION_ENGINE=local

# SQLite Async Database Connection String
DATABASE_URL=sqlite+aiosqlite:///./codescore.db

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
